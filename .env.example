# Optional. Everything has a safe default; the demo needs no tenant and no credentials.
# PORT must be in 5450-5499.
PORT=5450
# PAT_BIND=127.0.0.1   # loopback only unless you set this on purpose

# One-click defaults for the Run it form. Leave empty to let the visitor type their own;
# whatever you put here appears pre-filled in the UI for this deployment.
# PAT_DEMO_COMPANY_ORIGIN=https://localhost:3001
# PAT_DEMO_PF_ISSUER=https://local.ping-devops.com:9031
# Optional: a second authorization server for the "PingOne" radio on the calls page (empty = shown as not configured here).
# PAT_DEMO_P1_ISSUER=
# PAT_DEMO_SCOPE=accounts:read
# Optional: sent as login_hint on every sign-in so the authorization server pre-fills the username.
# PAT_DEMO_LOGIN_HINT=

# Optional: a live Claude agent behind the "Agent chat" tab. Without a key the chat is a guided script.
# The key stays on the server: never returned by the API and never logged. Model calls go to api.anthropic.com only.
# ANTHROPIC_API_KEY=
# PAT_CHAT_MODEL=claude-opus-5-5
