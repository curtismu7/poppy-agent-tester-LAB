# Optional. Everything has a safe default; the demo needs no tenant and no credentials.
# PORT must be in 5450-5499.
PORT=5450
# PAT_BIND=127.0.0.1   # loopback only unless you set this on purpose

# One-click defaults for the Run it form. Leave empty to let the visitor type their own;
# whatever you put here appears pre-filled in the UI for this deployment.
# PAT_DEMO_COMPANY_ORIGIN=https://localhost:3001
# PAT_DEMO_PF_ISSUER=https://local.ping-devops.com:9031
# PAT_DEMO_SCOPE=accounts:read
